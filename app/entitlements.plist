<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Identidad. Debe coincidir con CFBundleIdentifier. -->
	<key>application-identifier</key>
	<string>com.lofturb.isend</string>
	<key>com.apple.developer.team-identifier</key>
	<string>com.lofturb</string>
	<key>keychain-access-groups</key>
	<array>
		<string>com.lofturb.isend</string>
	</array>

	<!-- App de jailbreak: sin sandbox. Es necesaria para poder compartir
	     carpetas como /var/mobile/Documents, no solo el contenedor propio. -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>

	<!-- Acceso amplio al sistema de ficheros: la app puede publicar desde
	     Documentos hasta la raiz. El permiso real de escritura sigue
	     dependiendo de los permisos Unix de cada ruta. -->
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
		<string>/private/</string>
		<string>/var/</string>
		<string>/var/mobile/</string>
		<string>/var/mobile/Documents/</string>
		<string>/var/mobile/Media/</string>
		<string>/private/var/</string>
		<string>/private/var/mobile/</string>
	</array>
	<key>com.apple.security.exception.files.absolute-path.read-only</key>
	<array>
		<string>/</string>
		<string>/System/</string>
	</array>

	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
